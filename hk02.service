[Unit]
Description=hk02 AI数学成绩提升系统 MathBoost (Flask+Gunicorn)
After=network.target

[Service]
User=claudeuser
Group=claudeuser
WorkingDirectory=/data/www/hk02
ExecStart=/data/www/hk02/venv/bin/gunicorn --bind 127.0.0.1:8041 --workers 2 --threads 4 --timeout 120 --access-logfile logs/access.log --error-logfile logs/error.log app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
